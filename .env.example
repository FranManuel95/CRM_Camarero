# Carpeta donde se guarda el estado del local (por defecto ./datos). Haz copia de seguridad de ella.
DATOS_DIR=
# Dirección pública para los QR de las mesas (por ejemplo http://192.168.1.50:3000 o tu dominio).
URL_PUBLICA=
# Secreto para firmar las sesiones. Si no se pone, se genera uno en DATOS_DIR/secreto.
SESION_SECRETO=
# En un local de verdad: DEMO=false y NEXT_PUBLIC_DEMO=false (quita los PIN de ejemplo y el reinicio).
DEMO=
NEXT_PUBLIC_DEMO=

# --- En la nube (Supabase). Si TPV_CLAVE está puesta, se usa Supabase en vez del archivo. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Identificador del local (tabla public.locales).
TPV_LOCAL=
# Clave secreta del local: en la base de datos solo se guarda su SHA-256 (privado.claves).
TPV_CLAVE=

# --- Opcional: IA para leer facturas y la carta desde una foto. ---
# Se prueba en cadena: si una está saturada o falla, pasa a la siguiente. Basta con una.
# 1) Gemini (aistudio.google.com, tiene uso gratuito):
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-2.5-flash
# 2) Cualquier API compatible con OpenAI (OpenRouter, Mistral, Groq, OpenAI, DeepSeek…):
# IA_URL=https://openrouter.ai/api/v1
IA_CLAVE=
# IA_MODELO=
# IA_PDF=1   (si ese modelo acepta PDF)
# 3) Claude (console.anthropic.com):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-opus-5-5
# Orden de la cadena (por defecto gemini,compatible,anthropic):
# IA_ORDEN=gemini,compatible,anthropic

# --- Aviso legal y privacidad de la plataforma (/legal) y del encargado en las de cada bar. ---
# Si faltan, se usan VERIFACTU_PRODUCTOR_NOMBRE y VERIFACTU_PRODUCTOR_NIF.
LEGAL_TITULAR_NOMBRE=
LEGAL_TITULAR_NIF=
LEGAL_TITULAR_CORREO=
